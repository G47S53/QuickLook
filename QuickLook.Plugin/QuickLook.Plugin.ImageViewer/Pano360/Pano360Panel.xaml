<UserControl x:Class="QuickLook.Plugin.ImageViewer.Pano360.Pano360Panel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="Transparent"
             Focusable="True">

    <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

        <!-- Viewport 3D : occupe toute la surface disponible -->
        <Viewport3D x:Name="viewport3D"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ClipToBounds="True" />

        <!-- Barre d'outils flottante en bas -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,12"
                    Opacity="0.75">

            <!-- Bouton SpaceMouse activer/désactiver -->
            <ToggleButton x:Name="btnSpaceMouse"
                          Content="🖱 SpaceMouse"
                          ToolTip="Activer / désactiver la SpaceMouse 3Dconnexion"
                          Padding="8,4"
                          Margin="4,0"
                          Checked="BtnSpaceMouse_Checked"
                          Unchecked="BtnSpaceMouse_Unchecked" />

            <!-- Indicateur FOV (zoom) -->
            <Border Background="#AA000000"
                    CornerRadius="4"
                    Padding="8,4"
                    Margin="4,0">
                <TextBlock x:Name="txtFov"
                           Foreground="White"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Text="FOV: 90°" />
            </Border>

        </StackPanel>

        <!-- Indicateur de chargement -->
        <TextBlock x:Name="txtLoading"
                   Text="Chargement 360°…"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="White"
                   FontSize="16"
                   Visibility="Collapsed" />

    </Grid>

</UserControl>
