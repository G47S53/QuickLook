<!--
    Pano360Panel.xaml — Vue XAML de la visionneuse 360°
    
    Modifications apportées (Guillaume) :
    ─────────────────────────────────────────────────────────────────────────────
    1. BOUTON AUTOROTATION (3 états)
       Un ToggleButton nommé "btnAutoRotate" est ajouté à droite du bouton FOV.
       Le texte du bouton change selon l'état (Off / Rapide / Lent) via le
       code-behind (voir Pano360Panel.xaml.cs).

    2. FOND SEMI-TRANSPARENT ARRONDI
       Les 3 boutons (SpaceMouse, FOV, AutoRotate) sont maintenant encapsulés
       dans une Border avec CornerRadius et Background semi-transparent.
       Cela garantit la lisibilité quelle que soit l'image affichée.

    3. OPACITÉ PILOTÉE PAR LE MOUVEMENT
       L'attribut Opacity="..." qui était codé en dur dans le code-behind a été
       retiré. L'opacité est désormais gérée dynamiquement par la méthode
       UpdateBarreOpacity() dans le code-behind, qui réagit à tout mouvement
       (souris, SpaceMouse, autorotation).
    ─────────────────────────────────────────────────────────────────────────────
-->
<UserControl
    x:Class="QuickLook.Plugin.ImageViewer.Pano360.Pano360Panel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="800"
    Background="Black"
    Focusable="True">

    <Grid>

        <!-- ── Viewport 3D : la sphère panoramique ────────────────────────── -->
        <Viewport3D x:Name="viewport3D" />

        <!-- ── Texte de chargement (masqué dès que la scène est prête) ──────── -->
        <TextBlock
            x:Name="txtLoading"
            Text="Chargement…"
            Foreground="White"
            FontSize="18"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

        <!-- ══════════════════════════════════════════════════════════════════
             BARRE DE CONTRÔLE (en bas à gauche)
             ── x:Name="barreBtn" permet au code-behind de piloter l'Opacity.
             ── L'Opacity initiale est 1 ; elle sera animée par UpdateBarreOpacity().
        ══════════════════════════════════════════════════════════════════════ -->
        <StackPanel
            x:Name="barreBtn"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="12,0,0,12"
            Opacity="1">

            <!--
                BORDURE ARRONDIE semi-transparente qui englobe les 3 boutons.
                ── Background : noir à 45 % d'opacité → lisible sur toute image.
                ── CornerRadius="10" : coins arrondis pour un look "pill".
                ── Padding interne pour ne pas coller les boutons aux bords.
            -->
            <Border
                Background="#73000000"
                CornerRadius="10"
                Padding="8,4">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- ── Bouton SpaceMouse ─────────────────────────────── -->
                    <ToggleButton
                        x:Name="btnSpaceMouse"
                        Content="🖱 SpaceMouse"
                        Width="105"
                        Margin="0,0,6,0"
                        Padding="8,4"
                        Foreground="White"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Activer / désactiver la SpaceMouse 3Dconnexion"
                        Checked="BtnSpaceMouse_Checked"
                        Unchecked="BtnSpaceMouse_Unchecked">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <!-- Fond légèrement teinté quand IsChecked -->
                                            <Border
                                                x:Name="bd"
                                                Background="Transparent"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                                <ContentPresenter
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#4400AAFF" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <!-- Séparateur vertical léger -->
                    <Separator
                        Width="3"
                        Height="18"
                        Background="#55FFFFFF"
                        Margin="0,0,6,0" />

                    <!-- ── Affichage FOV ──────────────────────────────────── -->
                    <!--
                        txtFov affiche la valeur courante du champ de vision.
                        Il est mis à jour dans OnMouseWheel() et OnKeyDown().
                    -->
                    <TextBlock
                        x:Name="txtFov"
                        Text="(FOV: 90°)"
                        Foreground="White"
                        FontSize="13"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        ToolTip="Molette ou +/- pour zoomer" />

                    <!-- Séparateur vertical léger -->
                    <Separator
                        Width="3"
                        Height="18"
                        Background="#55FFFFFF"
                        Margin="0,0,6,0" />

                    <!-- ── Bouton AUTOROTATION (3 états) ─────────────────── -->
                    <!--
                        Ce bouton cycle entre 3 états à chaque clic :
                          Off  →  Rapide  →  Lent  →  Off  → …
                        
                        Le texte affiché ("⏸ Off", "🐢 Lent", "⏩ Rapide") est
                        mis à jour dans BtnAutoRotate_Click() dans le code-behind.
                        
                        x:Name="btnAutoRotate" est référencé dans le code-behind.
                    -->
                    <Button
                        x:Name="btnAutoRotate"
                        Content="⏸ Off"
                        Padding="8,4"
                        Foreground="White"
                        Width="105"
                        Cursor="Hand"
                        ToolTip="Autorotation : Off → Lent → Rapide → Off"
                        Click="BtnAutoRotate_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="bd"
                                                Background="Transparent"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                                <ContentPresenter
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#55FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                </StackPanel>
            </Border>

        </StackPanel>
        <!-- ── Fin barreBtn ──────────────────────────────────────────────── -->

    </Grid>
</UserControl>
