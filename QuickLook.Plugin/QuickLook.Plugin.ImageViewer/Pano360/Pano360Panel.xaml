<UserControl
    x:Class="QuickLook.Plugin.ImageViewer.Pano360.Pano360Panel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="800"
    Background="Black"
    Focusable="True">

    <Grid>

        <!-- ── Viewport 3D : la sphère panoramique ────────────────────────── -->
        <Viewport3D x:Name="viewport3D" />

        <!-- ── Texte de chargement (masqué dès que la scène est prête) ──────── -->
        <TextBlock
            x:Name="txtLoading"
            Text="Chargement…"
            Foreground="White"
            FontSize="18"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

        <!-- ══════════════════════════════════════════════════════════════════
             BARRE DE CONTRÔLE (en bas à gauche)
             ── x:Name="barreBtn" permet au code-behind de piloter l'Opacity.
             ── L'Opacity initiale est 1 ; elle sera animée par UpdateBarreOpacity().
        ══════════════════════════════════════════════════════════════════════ -->
        <StackPanel
            x:Name="barreBtn"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="12,0,0,12"
            Opacity="1"
            MouseEnter="BarreBtn_MouseEnter"
            MouseLeave="BarreBtn_MouseLeave">

            <StackPanel.Resources>
                <Storyboard x:Key="FadeOutBarreBtn">
                    <DoubleAnimation Storyboard.TargetName="barreBtn" 
                             Storyboard.TargetProperty="Opacity" 
                             To="0.15" Duration="0:0:0.4" />
                </Storyboard>
                <Storyboard x:Key="FadeInBarreBtn">
                    <DoubleAnimation Storyboard.TargetName="barreBtn" 
                             Storyboard.TargetProperty="Opacity" 
                             To="1" Duration="0:0:0.3" />
                </Storyboard>
            </StackPanel.Resources>

            <!--
                BORDURE ARRONDIE semi-transparente qui englobe les 3 boutons.
                ── Background : noir à 45 % d'opacité → lisible sur toute image.
                ── CornerRadius="10" : coins arrondis pour un look "pill".
                ── Padding interne pour ne pas coller les boutons aux bords.
            -->
            <Border Background="#73000000" CornerRadius="10" Padding="8,4">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- ── Bouton SpaceMouse ─────────────────────────────── -->
                    <ToggleButton
                        x:Name="btnSpaceMouse"
                        Width="105"
                        Margin="0,0,6,0"
                        Padding="8,4"
                        Foreground="White"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Activer / désactiver la SpaceMouse 3Dconnexion"
                        Checked="BtnSpaceMouse_Checked"
                        Unchecked="BtnSpaceMouse_Unchecked">
                        <TextBlock x:Name="txtSpaceMouse" Text="🖱 3D Mouse" />
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <!-- Fond légèrement teinté quand IsChecked -->
                                            <Border
                                                x:Name="bd"
                                                Background="Transparent"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                                <ContentPresenter
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#4400AAFF" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <!-- Séparateur vertical léger -->
                    <Separator
                        Width="3"
                        Height="18"
                        Background="#55FFFFFF"
                        Margin="0,0,6,0" />

                    <!-- ── Affichage FOV ──────────────────────────────────── -->
                    <!--
                        txtFov affiche la valeur courante du champ de vision.
                        Il est mis à jour dans OnMouseWheel() et OnKeyDown().
                    -->
                    <TextBlock
                        x:Name="txtFov"
                        Text="(FOV: 90°)"
                        Foreground="#999999"
                        FontSize="13"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        ToolTip="Molette pour le zoom">
                        <TextBlock.Resources>
                            <Storyboard x:Key="FadeFovStoryboard">
                                <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)">
                                    <DiscreteColorKeyFrame KeyTime="0:0:0" Value="White" />
                                    <LinearColorKeyFrame KeyTime="0:0:1.5" Value="White" />
                                    <LinearColorKeyFrame KeyTime="0:0:2.0" Value="#999999" />
                                </ColorAnimationUsingKeyFrames>
                                <!-- 
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="FontSize">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="13" />
                                    <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="13" />
                                    <LinearDoubleKeyFrame KeyTime="0:0:2.0" Value="12" />
                                </DoubleAnimationUsingKeyFrames>
                                
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="FontWeight">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                        <DiscreteObjectKeyFrame.Value>
                                            <FontWeight>Bold</FontWeight>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>

                                    <DiscreteObjectKeyFrame KeyTime="0:0:1.5">
                                        <DiscreteObjectKeyFrame.Value>
                                            <FontWeight>Normal</FontWeight>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>
                                </ObjectAnimationUsingKeyFrames>  -->
                            </Storyboard>
                        </TextBlock.Resources>
                    </TextBlock>

                    <!-- Séparateur vertical léger -->
                    <Separator
                        Width="3"
                        Height="18"
                        Background="#55FFFFFF"
                        Margin="0,0,6,0" />

                    <!-- ── Bouton AUTOROTATION (3 états) ─────────────────── -->
                    <!--
                        Ce bouton cycle entre 3 états à chaque clic :
                          Off  →  Lent  → Normal →  Rapide  →  Off  → …
                        
                        Le texte affiché ("⏸ Off", "🐢 Lent", ," normal", "⏩ Rapide") est
                        mis à jour dans BtnAutoRotate_Click() dans le code-behind.
                        
                        x:Name="btnAutoRotate" est référencé dans le code-behind.
                    -->
                    <Button
                        x:Name="btnAutoRotate"
                        Content="⏸ Off"
                        Padding="8,4"
                        Foreground="White"
                        Width="105"
                        Cursor="Hand"
                        ToolTip="Autorotation : Off → Lent → Normal → Rapide → Off"
                        Click="BtnAutoRotate_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="bd"
                                                Background="Transparent"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                                <ContentPresenter
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#55FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Separator
                        Width="3"
                        Height="18"
                        Background="#55FFFFFF"
                        Margin="0,0,6,0" />

                    <Button
                        x:Name="btnAutoClose"
                        Width="120"
                        Padding="8,4"
                        Foreground="White"
                        Cursor="Hand"
                        ToolTip="Fermer automatiquement la fenêtre après un tour complet (Disponible uniquement si l'autorotation est active)"
                        Click="BtnAutoClose_Click">

                        <TextBlock x:Name="txtAutoClose" Text="🚪 AutoClose: Off" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="bd"
                                                Background="Transparent"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                                <ContentPresenter
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#55FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="bd" Property="Background" Value="Transparent" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

        </StackPanel>
        <!-- ── Fin barreBtn ──────────────────────────────────────────────── -->

    </Grid>
</UserControl>
