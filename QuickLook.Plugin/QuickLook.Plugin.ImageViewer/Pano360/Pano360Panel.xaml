<UserControl
    x:Class="QuickLook.Plugin.ImageViewer.Pano360.Pano360Panel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="800"
    Background="Black"
    Focusable="True">

    <UserControl.Resources>
        <Storyboard x:Key="AnimatePrevArrow">
            <ColorAnimation Storyboard.TargetName="btnPrevPano" 
                        Storyboard.TargetProperty="(Button.Foreground).(SolidColorBrush.Color)"
                        Duration="0:0:0.7">
                <ColorAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </ColorAnimation.EasingFunction>
            </ColorAnimation>
        </Storyboard>

        <Storyboard x:Key="AnimateNextArrow">
            <ColorAnimation Storyboard.TargetName="btnNextPano" 
                        Storyboard.TargetProperty="(Button.Foreground).(SolidColorBrush.Color)"
                        Duration="0:0:0.7">
                <ColorAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </ColorAnimation.EasingFunction>
            </ColorAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid>

        <!-- ── Viewport 3D : la sphère panoramique ────────────────────────── -->
        <Viewport3D x:Name="viewport3D">
            <Viewport3D.Effect>
                <BlurEffect x:Name="viewBlur" Radius="0" KernelType="Box"/>
            </Viewport3D.Effect>
        </Viewport3D>

        <!-- ══════════════════════════════════════════════════════════════════
             BARRE DE CONTRÔLE (en bas à gauche)
             ── x:Name="barreBtn" permet au code-behind de piloter l'Opacity.
             ── L'Opacity initiale est 1 ; elle sera animée par UpdateBarreOpacity().
        ══════════════════════════════════════════════════════════════════════ -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="56" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="70" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="barreBtn" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8" Opacity="1" VerticalAlignment="Bottom" MouseEnter="BarreBtn_MouseEnter" MouseLeave="BarreBtn_MouseLeave">
                <StackPanel.Resources>
                    <Storyboard x:Key="FadeOutBarreBtn">
                        <DoubleAnimation Storyboard.TargetName="barreBtn" Storyboard.TargetProperty="Opacity" To="0.15" Duration="0:0:0.4" />
                    </Storyboard>
                    <Storyboard x:Key="FadeInBarreBtn">
                        <DoubleAnimation Storyboard.TargetName="barreBtn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" />
                    </Storyboard>
                </StackPanel.Resources>

                <Border Background="#73000000" CornerRadius="10" Padding="12,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="32">
                        <!-- ── Barre de gauche ───────────────────────────────── -->
                        <StackPanel x:Name="grpBarreGauche" Orientation="Horizontal" VerticalAlignment="Center" MaxWidth="500">
                            <!-- ── Bouton Options ────────────────────────────────── -->
                            <Button x:Name="btnOptions" Content="🔧 Options" Width="120" Margin="0,0,6,0" Padding="4" Foreground="White" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Ouvrir les options" Click="BtnOptions_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- ── Bouton SpaceMouse ─────────────────────────────── -->
                            <ToggleButton x:Name="btnSpaceMouse" Width="120" Margin="0,0,6,0" Padding="8,4" Foreground="White" Background="Transparent" BorderThickness="0" Cursor="Hand" Checked="BtnSpaceMouse_Checked" Unchecked="BtnSpaceMouse_Unchecked">
                                <TextBlock x:Name="txtSpaceMouse" Text="🖱 3D Mouse" />
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#4400AAFF" />
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                        </StackPanel>
                        <!-- ── Bouton Panorama Précédent ─────────────────────── -->
                        <Button x:Name="btnPrevPano" Content="◀" Width="28" Height="28" Margin="4,0,0,0" Cursor="Hand" ToolTip="Panorama précédent (←)" Click="BtnBarrePrevPano_Click">
                            <Button.Foreground>
                                <SolidColorBrush Color="Black" />
                            </Button.Foreground>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="2">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#55FFFFFF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- ── Affichage FOV ─────────────────────────────────── -->
                        <TextBlock x:Name="txtFov" Text="(FOV: 90°)" Width="75" TextAlignment="Center" Foreground="#999999" FontSize="13" VerticalAlignment="Center" Margin="4,0" Background="Transparent" Cursor="Hand" ToolTip="Double-cliquez pour compacter/agrandir" MouseLeftButtonDown="TxtFov_MouseLeftButtonDown">
                            <TextBlock.Resources>
                                <Storyboard x:Key="FadeFovStoryboard">
                                    <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)">
                                        <DiscreteColorKeyFrame KeyTime="0:0:0" Value="White" />
                                        <LinearColorKeyFrame KeyTime="0:0:1.5" Value="White" />
                                        <LinearColorKeyFrame KeyTime="0:0:2.0" Value="#999999" />
                                    </ColorAnimationUsingKeyFrames>
                                </Storyboard>
                            </TextBlock.Resources>
                        </TextBlock>

                        <!-- ── Bouton Panorama Suivant ───────────────────────── -->
                        <Button x:Name="btnNextPano" Content="▶" Width="28" Height="28" Margin="0,0,4,0" Cursor="Hand" ToolTip="Panorama suivant (→)" Click="BtnBarreNextPano_Click">
                            <Button.Foreground>
                                <SolidColorBrush Color="Black" />
                            </Button.Foreground>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="2">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#55FFFFFF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- ── Barre de droite ───────────────────────────────── -->
                        <StackPanel x:Name="grpBarreDroite" Orientation="Horizontal" VerticalAlignment="Center" MaxWidth="500">
                            <!-- ── Bouton AUTOROTATION ───────────────────────────── -->
                            <Button x:Name="btnAutoRotate" Background="Transparent" Content="Rotation auto." Width="120" Padding="8,4" Margin="6,0,0,0" Foreground="White" Cursor="Hand" Click="BtnAutoRotate_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#55FFFFFF" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- ── Bouton AUTOCLOSE ──────────────────────────────── -->
                            <Button x:Name="btnAutoClose" Background="Transparent" Width="120" Padding="8,4" Margin="6,0,0,0" Foreground="White" Cursor="Hand" Click="BtnAutoCloseAutoNext_Click">
                                <TextBlock x:Name="txtAutoClose" Text="1 tour + ... : Off" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#55FFFFFF" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="bd" Property="Background" Value="Transparent" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                    </StackPanel>
                </Border>
            </StackPanel>
            <!-- ── Info avancement rond autoclose ───────────── -->
            <Grid x:Name="panelAutoCloseProgress" Grid.Column="2" Width="56" Height="56" HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="Collapsed" Opacity="1" MouseEnter="BarreBtn_MouseEnter" MouseLeave="BarreBtn_MouseLeave">
                <Grid.Resources>
                    <Storyboard x:Key="FadeOutProgress">
                        <DoubleAnimation Storyboard.TargetName="panelAutoCloseProgress" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.4" />
                    </Storyboard>
                    <Storyboard x:Key="FadeInProgress">
                        <DoubleAnimation Storyboard.TargetName="panelAutoCloseProgress" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.3" />
                    </Storyboard>
                </Grid.Resources>
                <Border Background="#73000000" CornerRadius="28" BorderBrush="#22FFFFFF" BorderThickness="1">
                    <Grid Margin="6">
                        <Ellipse Stroke="#33FFFFFF" StrokeThickness="2.5" />
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="rectProgressTransform" Angle="0" />
                            </Grid.RenderTransform>
                            <Ellipse Width="7" Height="7" Fill="#FF00AAFF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-2.5,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="0" Color="#FF00AAFF" Opacity="0.9"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <TextBlock x:Name="txtTempsRestant" Text="⏳" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ── Préférences ──────────────────────────────── -->

        <Grid x:Name="gridPreferences" Visibility="Collapsed" Background="#33000000" Panel.ZIndex="1000" MouseDown="GridPreferences_MouseDown" PreviewMouseWheel="GridPreferences_PreviewMouseWheel">

            <Border Background="#FA1A1A1A" CornerRadius="12" BorderBrush="#33FFFFFF" BorderThickness="1" Width="480" Height="640" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- ── Préparation onglets ───────────────── -->
                    <TextBlock Grid.Row="0" Text="Options de configuration" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0,1,0,0" BorderBrush="#22FFFFFF" Padding="0,10,0,0">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Foreground" Value="#99FFFFFF"/>
                                <Setter Property="Background" Value="{x:Null}"/>
                                <Setter Property="Padding" Value="12,6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="bd" 
                                Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}" 
                                Margin="0,0,4,0" 
                                CornerRadius="4,4,0,0"
                                TextOptions.TextRenderingMode="ClearType">
                                                <TextBlock Text="{TemplateBinding Header}" 
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger SourceName="bd" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#11FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>

                        <!-- ── Onglet démarrage ──────────────────── -->
                        <TabItem Header="Démarrage">
                            <StackPanel Margin="10,15,10,0">

                                <CheckBox x:Name="chkFullscreen" Content="Lancer en plein écran" Foreground="White" Margin="0,0,0,6" Cursor="Hand"/>
                                <CheckBox x:Name="chkBarreReduite" Content="Démarrer avec la barre de boutons réduite" Margin="0,6,0,6" Foreground="White"/>
                                <Border Height="2" Width="220" HorizontalAlignment="Center" Margin="0,10,0,25" Background="#18FFFFFF"/>
                                <TextBlock Text="Champ de vision par défaut (FOV) :" Foreground="#AAFFFFFF" Margin="0,0,0,5"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="sldFov" Minimum="30" Maximum="135" Value="90" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" ValueChanged="SldFov_ValueChanged"/>
                                    <TextBlock Grid.Column="1" x:Name="lblFovValue" Text="90°" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Border Height="2" Width="220" HorizontalAlignment="Center" Margin="0,10,0,25" Background="#18FFFFFF"/>


                                <StackPanel Orientation="Vertical" Margin="10,0,10,0">
                                    <StackPanel.Resources>
                                        <Style TargetType="RadioButton">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Width" Value="160"/>
                                        </Style>
                                    </StackPanel.Resources>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <RadioButton x:Name="radStartNormal" Content="Panorama statique" GroupName="StartMode" IsChecked="True" Click="RadioBtnMode_Click"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,12">
                                        <RadioButton x:Name="radStartAutoRotate" Content="Rotation automatique" GroupName="StartMode" Click="RadioBtnMode_Click"/>

                                        <Button x:Name="btnOptionAutoRotate" Visibility="Hidden" Width="150" Padding="10,4" Margin="15,0,0,0" Foreground="White" Cursor="Hand" Click="BtnOptionAutoRotate_Click">
                                            <TextBlock x:Name="txtOptionAutoRotate" TextAlignment="Center" Text="🐢 Lent" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bd" Background="#22FFFFFF" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="bd" Property="Background" Value="#44FFFFFF" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="bd" Property="Background" Value="#66FFFFFF" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>

                                    <StackPanel Orientation="Vertical" Margin="0,12,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <RadioButton x:Name="radStartAutoClose" Content="1 tour + fermeture" GroupName="StartMode" Click="RadioBtnMode_Click"/>
                                            
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,20,0,6">
                                            <RadioButton x:Name="radStartAutoSuivant" GroupName="StartMode" Click="RadioBtnMode_Click" VerticalContentAlignment="Center">
                                                <TextBlock Text="1 tour + panorama suivant" TextWrapping="Wrap" MaxWidth="340"/>
                                            </RadioButton>
                                             <TextBlock x:Name="TextAutoClose" Visibility="Hidden" Text="⚙ Durée :" Foreground="#AAFFFFFF" Margin="0,0,0,0" VerticalAlignment="Center" FontSize="11" FontStyle="Italic"/>
                                        </StackPanel>
                                        <Grid Margin="150,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="45"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="sldAutoCloseDelay" Minimum="5" Maximum="60" Value="15" Visibility="Hidden" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="SldAutoCloseDelay_ValueChanged"/>
                                            <TextBlock Grid.Column="1" x:Name="lblAutoCloseDelayValue" Text="15s" Visibility="Hidden" Foreground="#FF00AAFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </TabItem>

                        <!-- ── Onglet Autorotation ───────────────── -->
                        <TabItem Header="Autorotation">
                            <StackPanel Margin="10,45,10,0">
                                <TextBlock Text="Durée d'un tour complet (en secondes) :" Foreground="#AAFFFFFF" Margin="0,0,0,10" FontSize="12" FontStyle="Italic"/>

                                <TextBlock Text="Mode Lent" Margin="0,15,0,0" Foreground="White" FontSize="11"/>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="sldSlow" Minimum="46" Maximum="120" Value="60" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="SldSlow_ValueChanged"/>
                                    <TextBlock Grid.Column="1" x:Name="lblSlow" Text="60 s" Foreground="#FF00AAFF" HorizontalAlignment="Right"/>
                                </Grid>

                                <TextBlock Text="Mode Normal" Foreground="White" FontSize="11"/>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="sldNormal" Minimum="16" Maximum="45" Value="20" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="SldNormal_ValueChanged"/>
                                    <TextBlock Grid.Column="1" x:Name="lblNormal" Text="20 s" Foreground="#FF00AAFF" HorizontalAlignment="Right"/>
                                </Grid>

                                <TextBlock Text="Mode Rapide" Foreground="White" FontSize="11"/>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="sldFast" Minimum="5" Maximum="15" Value="10" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="SldFast_ValueChanged"/>
                                    <TextBlock Grid.Column="1" x:Name="lblFast" Text="10 s" Foreground="#FF00AAFF" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </TabItem>
                    </TabControl>

                    <!-- ── Bouton de fermeture ───────────────── -->
                    <Button Grid.Row="2" Content="Enregistrer et Fermer" HorizontalAlignment="Right" Width="170" Padding="10,6" Margin="0,15,0,0" Cursor="Hand" Click="BtnCloseOptions_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#FF00AAFF"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF33BBFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
        <!-- ── Info texte PopUp  ────────────────────────── -->
        <Border x:Name="infoPopup" Padding="20,10,20,10" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#CC222222" CornerRadius="8" IsHitTestVisible="False" Opacity="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.7"/>
            </Border.Effect>
            <TextBlock x:Name="txtInfoPopup" FontSize="26" FontWeight="SemiBold" Foreground="White" Text="Fermeture automatique..." />
            <Border.Resources>
                <Storyboard x:Key="StoryboardShowInfo">
                    <DoubleAnimationUsingKeyFrames Storyboard.Target="{Binding Source={x:Reference infoPopup}}" Storyboard.TargetProperty="Opacity">
                        <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="0.9" />
                        <LinearDoubleKeyFrame KeyTime="0:0:1.0" Value="0.9" />
                        <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                </Storyboard>
                <Storyboard x:Key="StoryboardShowInfoMoyen">
                    <DoubleAnimationUsingKeyFrames Storyboard.Target="{Binding Source={x:Reference infoPopup}}" Storyboard.TargetProperty="Opacity">
                        <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="0.9" />
                        <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="0.9" />
                        <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                </Storyboard>
                <Storyboard x:Key="StoryboardShowInfoRapide">
                    <DoubleAnimationUsingKeyFrames Storyboard.Target="{Binding Source={x:Reference infoPopup}}" Storyboard.TargetProperty="Opacity">
                        <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="0.7" />
                        <LinearDoubleKeyFrame KeyTime="0:0:1.0" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                </Storyboard>
                <Storyboard x:Key="StoryboardShowInfoUltraRapide">
                    <DoubleAnimationUsingKeyFrames Storyboard.Target="{Binding Source={x:Reference infoPopup}}" Storyboard.TargetProperty="Opacity">
                        <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="0.7" />
                        <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                </Storyboard>
            </Border.Resources>
        </Border>
        <!-- ── Barre Rating  ────────────────────────────── -->
        <Border x:Name="panelRating" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,75" Background="#80000000" CornerRadius="10" Padding="8,2" RenderTransformOrigin="0.5,0.5" MouseEnter="BarrePanelRating_MouseEnter" MouseLeave="BarrePanelRating_MouseLeave">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="panelRatingScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="panelRatingTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Resources>
                <Storyboard x:Key="FadeOutRating">
                    <DoubleAnimation Storyboard.TargetName="panelRating" Storyboard.TargetProperty="Opacity" To="0.15" Duration="0:0:0.4" />
                </Storyboard>
                <Storyboard x:Key="FadeOutFullRating">
                    <DoubleAnimation Storyboard.TargetName="panelRating" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.4" />
                </Storyboard>
                <Storyboard x:Key="FadeInRating">
                    <DoubleAnimation Storyboard.TargetName="panelRating" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.3" />
                </Storyboard>
                <!-- FadeOut : rétrécit + disparaît -->
                <Storyboard x:Key="FadeOutEtZoomRating" Completed="FadeOutZoomEtOpacityRating_Completed">
                    <DoubleAnimation Storyboard.TargetName="panelRating"
                     Storyboard.TargetProperty="Opacity"
                     To="0" Duration="0:0:0.25"/>
                    <DoubleAnimation Storyboard.TargetName="panelRatingScale"
                     Storyboard.TargetProperty="ScaleX"
                     To="0.8" Duration="0:0:0.25"/>
                    <DoubleAnimation Storyboard.TargetName="panelRatingScale"
                     Storyboard.TargetProperty="ScaleY"
                     To="0.8" Duration="0:0:0.25"/>
                    <!-- Descend vers la barre -->
                    <DoubleAnimation Storyboard.TargetName="panelRatingTranslate"
                     Storyboard.TargetProperty="Y"
                     To="20" Duration="0:0:0.25"/>
                </Storyboard>
                <!-- FadeIn : grandit + apparaît -->
                <Storyboard x:Key="FadeInEtZoomRating">
                    <DoubleAnimation Storyboard.TargetName="panelRating"
                     Storyboard.TargetProperty="Opacity"
                     To="1.0" Duration="0:0:0.3"/>
                    <DoubleAnimation Storyboard.TargetName="panelRatingScale"
                     Storyboard.TargetProperty="ScaleX"
                     From="0.8" To="1.0" Duration="0:0:0.3"/>
                    <DoubleAnimation Storyboard.TargetName="panelRatingScale"
                     Storyboard.TargetProperty="ScaleY"
                     From="0.8" To="1.0" Duration="0:0:0.3"/>
                    <!-- Monte depuis la barre -->
                    <DoubleAnimation Storyboard.TargetName="panelRatingTranslate"
                     Storyboard.TargetProperty="Y"
                     From="20" To="0" Duration="0:0:0.3"/>
                </Storyboard>

            </Border.Resources>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="PointColorLeft" Content="⚫" FontSize="6" Foreground="Gray" Background="Transparent" BorderThickness="0" Click="Color_Click" Cursor="Hand" Margin="2,0"/>
                <Button x:Name="Star1" Tag="1" Content="☆" FontSize="18" Foreground="Gray" Background="Transparent" BorderThickness="0" Click="Star_Click" Cursor="Hand" Margin="-3,0"/>
                <Button x:Name="Star2" Tag="2" Content="☆" FontSize="18" Foreground="Gray" Background="Transparent" BorderThickness="0" Click="Star_Click" Cursor="Hand" Margin="-3,0"/>
                <Button x:Name="Star3" Tag="3" Content="☆" FontSize="18" Foreground="Gray" Background="Transparent" BorderThickness="0" Click="Star_Click" Cursor="Hand" Margin="-3,0"/>
                <Button x:Name="Star4" Tag="4" Content="☆" FontSize="18" Foreground="Gray" Background="Transparent" BorderThickness="0" Click="Star_Click" Cursor="Hand" Margin="-3,0"/>
                <Button x:Name="Star5" Tag="5" Content="☆" FontSize="18" Foreground="Gray" Background="Transparent" BorderThickness="0" Click="Star_Click" Cursor="Hand" Margin="-3,0"/>
                <Button x:Name="PointColorRight" Content="⚫" FontSize="6" Foreground="Gray" Background="Transparent" BorderThickness="0" Click="Color_Click" Cursor="Hand" Margin="2,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>